[Unit]
Description=Portfolio API (formulario de contacto)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Sustituir por la ruta donde está clonado el repo en el servidor
WorkingDirectory=<RUTA_DEL_REPO>/api
# Sustituir por la ruta del fichero con variables de entorno en el servidor
EnvironmentFile=/etc/portfolio-api.env
# Ruta absoluta de node en el VPS: sustituir por el resultado de `which node`
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
